<mat-toolbar color="primary">
  <mat-toolbar-row fxLayout="row">
    <span>Mark as Completed - Edit Wastage</span>
    <span class="spacer"></span>
    <button class="mat-dialog-close" mat-icon-button mat-dialog-close>
      <mat-icon>close</mat-icon>
    </button>
  </mat-toolbar-row>
</mat-toolbar>

<mat-dialog-content class="mat-typography">
  <div class="bill-info">
    <table id="customers">
      <tr>
        <td><b>Bill: </b>{{ data?.bill }}</td>
        <td><b>Name: </b>{{ data?.name }}</td>
      </tr>
      <tr>
        <td><b>Contact Number: </b>{{ data?.contactNumber }}</td>
        <td><b>Total: </b>{{ data?.total }}</td>
      </tr>
    </table>
  </div>

  <div class="instructions">
    <mat-card>
      <mat-card-content>
        <strong>Instructions:</strong>
        <ol>
          <li>Enter the Wastage 2 amount for each product</li>
          <li>Click <strong>Save</strong> to calculate Daal and Waste automatically</li>
          <li>Click <strong>Complete</strong> to save all data and move bill to Completed tab</li>
        </ol>
        <p><strong>Formula:</strong> Reaming = Quantity - Wastage2 | Waste = Reaming / 3.3 | Daal = Reaming - Waste</p>
      </mat-card-content>
    </mat-card>
  </div>

  <div class="responsive_table">
    <table mat-table [dataSource]="dataSource" class="mat-elevation-z8">
      <ng-container matColumnDef="name">
        <th mat-header-cell *matHeaderCellDef>Name</th>
        <td mat-cell *matCellDef="let element">{{ element.name }}</td>
      </ng-container>

      <ng-container matColumnDef="price">
        <th mat-header-cell *matHeaderCellDef>Price</th>
        <td mat-cell *matCellDef="let element">{{ element.price }}</td>
      </ng-container>

      <ng-container matColumnDef="quantity">
        <th mat-header-cell *matHeaderCellDef>Quantity</th>
        <td mat-cell *matCellDef="let element">{{ element.quantity }}</td>
      </ng-container>

      <ng-container matColumnDef="daal">
        <th mat-header-cell *matHeaderCellDef>Daal</th>
        <td mat-cell *matCellDef="let element" [class.calculated]="element.daal !== null && element.daal !== undefined">
          {{ element.daal !== null && element.daal !== undefined ? element.daal : '-' }}
        </td>
      </ng-container>

      <ng-container matColumnDef="waste">
        <th mat-header-cell *matHeaderCellDef>Waste</th>
        <td mat-cell *matCellDef="let element" [class.calculated]="element.waste !== null && element.waste !== undefined">
          {{ element.waste !== null && element.waste !== undefined ? element.waste : '-' }}
        </td>
      </ng-container>

      <ng-container matColumnDef="total">
        <th mat-header-cell *matHeaderCellDef>Total</th>
        <td mat-cell *matCellDef="let element">{{ element.total }}</td>
      </ng-container>

      <ng-container matColumnDef="wastage2">
        <th mat-header-cell *matHeaderCellDef>Wastage 2</th>
        <td mat-cell *matCellDef="let element">
          <mat-form-field appearance="outline" class="wastage-field">
            <input 
              matInput 
              type="number" 
              [value]="element.wastage2 || 0"
              (change)="onWastage2Change(element, $event)"
              min="0"
              step="0.01"
            >
          </mat-form-field>
        </td>
      </ng-container>

      <tr mat-header-row *matHeaderRowDef="displayedColumns; sticky: true"></tr>
      <tr mat-row *matRowDef="let row; columns: displayedColumns"></tr>
    </table>
  </div>

  <div class="save-status" *ngIf="isSaved">
    <mat-icon>check_circle</mat-icon> Calculations saved successfully!
  </div>
</mat-dialog-content>

<mat-dialog-actions align="end">
  <button mat-raised-button color="warn" (click)="cancel()">
    <mat-icon>cancel</mat-icon>
    Cancel
  </button>
  <button mat-raised-button color="accent" (click)="save()">
    <mat-icon>save</mat-icon>
    Save
  </button>
  <button mat-raised-button color="primary" (click)="complete()">
    <mat-icon>check_circle</mat-icon>
    Complete
