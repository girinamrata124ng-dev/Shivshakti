    // Font fields - will be initialized lazily
    private PdfFont marathiFont = null;
    private PdfFont englishFont = null;

    private PdfFont getMarathiFont() throws IOException {
        if (marathiFont == null) {
            try {
                // Load Marathi font from classpath
                marathiFont = PdfFontFactory.createFont("fonts/NotoSansDevanagari-Regular.ttf");
            } catch (Exception e) {
                log.warn("Could not load Marathi font, using default: {}", e.getMessage());
                marathiFont = PdfFontFactory.createFont();
            }
        }
        return marathiFont;
    }

    private PdfFont getEnglishFont() {
        if (englishFont == null) {
            try {
                englishFont = PdfFontFactory.createFont();
            } catch (IOException e) {
                log.error("Error creating English font", e);
            }
        }
        return englishFont;
    }

    @Override
    public ResponseEntity<String> generateReport(Map<String, Object> requestMap) {
        log.info("Inside generateReport");

        try {
            if (validateResquestMap(requestMap)) {
                insertBill(requestMap);
                
                Integer bill = (Integer) requestMap.get("bill");
                String fileName = "Bill_" + bill;

                log.info("Bill generated with bill: {}", bill);

                String name = (String) requestMap.get("name");
                String contactNumber = (String) requestMap.get("contactNumber");
                String totalAmount = (String) requestMap.get("totalAmount");

                String filePath = CafeConstants.STORE_LOCATION + "\\" + fileName + ".pdf";
                generateBeautifulPdf(filePath, bill, name, contactNumber, totalAmount, requestMap);
                
                log.info("PDF generated successfully for bill: {}", bill);
                return new ResponseEntity<>("{\"bill\":\"" + bill + "\"}", HttpStatus.OK);
            }

            log.warn("Invalid request map for generateReport");
            return CafeUtils.getResponeEntity("Required data not found", HttpStatus.BAD_REQUEST);

        } catch (Exception ex) {
            log.error("Error in generateReport", ex);
            ex.printStackTrace();
        }

        return CafeUtils.getResponeEntity(CafeConstants.SOMETHING_WENT_WRONG,
                HttpStatus.INTERNAL_SERVER_ERROR);
    }

    private void generateBeautifulPdf(String filePath, Integer bill, String name, 
                                       String contactNumber, String totalAmount,
                                       Map<String, Object> requestMap) throws Exception {
        
        PdfWriter writer = new PdfWriter(filePath);
        PdfDocument pdf = new PdfDocument(writer);
        
        // Set no margins initially to allow full page background
        Document document = new Document(pdf, PageSize.A4);
        document.setMargins(0, 0, 0, 0);

        PdfFont marathiFont = getMarathiFont();
        PdfFont englishFont = getEnglishFont();

        log.info("Generating PDF - bill: {}, name: {}, contact: {}", bill, name, contactNumber);
        log.info("Product details: {}", requestMap.get("productDetails"));

        // ===== ADD BACKGROUND IMAGE =====
        try {
            // Load background image from classpath
            java.net.URL imageUrl = getClass().getClassLoader().getResource("images/background_bill.jpg");
            log.info("Image URL from classpath: {}", imageUrl);
            
            if (imageUrl == null) {
                // Try loading from file directly as fallback
                String imageFilePath = "Backend/src/main/resources/images/background_bill.jpg";
                java.io.File imageFile = new java.io.File(imageFilePath);
                log.info("Trying file path: {}, exists: {}", imageFilePath, imageFile.exists());
                
                if (imageFile.exists()) {
                    imageUrl = imageFile.toURI().toURL();
                    log.info("Image loaded from file: {}", imageUrl);
                } else {
                    log.warn("Background image not found in classpath or file system");
                }
            }
            
            if (imageUrl != null) {
                com.itextpdf.io.image.ImageData imageData = ImageDataFactory.create(imageUrl);
                
                float pageWidth = PageSize.A4.getWidth();
                float pageHeight = PageSize.A4.getHeight();
                
                // Add a new page first since the document doesn't have any pages yet
                pdf.addNewPage();
                
                // Add background image using PdfCanvas to the first page
                PdfCanvas canvas = new PdfCanvas(pdf.getFirstPage());
                canvas.addImageFittedIntoRectangle(
                        imageData,
                        new com.itextpdf.kernel.geom.Rectangle(0, 0, pageWidth, pageHeight),
                        false
                );
                
                log.info("Background image added successfully with URL: {}", imageUrl);
            }
        } catch (Exception e) {
            log.warn("Could not load background image: {}", e.getMessage());
            e.printStackTrace();
        }

        // Now set margins for content area
        document.setMargins(20, 20, 20, 20);

        // ===== DATE =====
        String currentDate = new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm")
                .format(new java.util.Date());
        
        Paragraph dateParagraph = new Paragraph("" + currentDate)
                .setFont(marathiFont)
                .setFontSize(14)
                .setFontColor(TEXT_COLOR)
                .setBold()
                .setTextAlignment(TextAlignment.RIGHT);
        document.add(dateParagraph);

        document.add(new Paragraph("\n"));
        
        // ===== CUSTOMER INFO: Name on left, Bill No + Mobile on right =====
        Table customerTable = new Table(UnitValue.createPercentArray(new float[]{1, 1}));
        customerTable.setWidth(UnitValue.createPercentValue(100));

        // Left side - Customer Name
        Cell nameCell = new Cell()
                .setBorder(null)
                .add(new Paragraph("नाव: " + name)
                        .setFont(marathiFont)
                        .setFontSize(15)
                        .setFontColor(PRIMARY_COLOR)
                        .setBold());
        
        // Right side - Bill No + Mobile Number
        Cell infoCell = new Cell()
                .setBorder(null)
                .setTextAlignment(TextAlignment.RIGHT)
                .add(new Paragraph("बिल क्र.: " + bill + "\n" + "संपर्क: " + contactNumber)
                        .setFont(marathiFont)
                        .setFontSize(14)
                        .setFontColor(TEXT_COLOR)
                        .setBold());
        
        customerTable.addCell(nameCell);
        customerTable.addCell(infoCell);
        document.add(customerTable);

        document.add(new Paragraph("\n"));

        // ===== PRODUCTS TABLE =====
        Table productTable = new Table(UnitValue.createPercentArray(new float[]{1, 3, 2, 2, 2, 2, 2, 2}));
        productTable.setWidth(UnitValue.createPercentValue(100));

        String[] headers = {"अ.क्र.", "नाव", "प्रमाण", "दाल", "चुनी", "तुट/तुकडा", "किंमत", "एकूण"};
        
        for (String header : headers) {
            Cell headerCell = new Cell()
                    .setPadding(8)
                    .add(new Paragraph(header)
                            .setFont(marathiFont)
                            .setFontSize(13)
                            .setFontColor(ColorConstants.WHITE)
                            .setBold()
                            .setTextAlignment(TextAlignment.CENTER));
            productTable.addHeaderCell(headerCell);
        }

        // Table Rows
        String productDetailsStr = (String) requestMap.get("productDetails");
        log.info("Parsing product details: {}", productDetailsStr);
        
        JSONArray jsonArray = CafeUtils.getJsonArrayFromString(productDetailsStr);
        log.info("Found {} products", jsonArray.length());

        for (int i = 0; i < jsonArray.length(); i++) {
            Map<String, Object> product = CafeUtils.getMapFromJson(jsonArray.getString(i));
            log.info("Product {}: {}", i, product);
            calculateWastage2ForProduct(product);

            DeviceRgb rowColor = (i % 2 == 0) ? new DeviceRgb(255, 255, 255) : new DeviceRgb(250, 240, 230);

            // Add Sr.No column
            productTable.addCell(createDataCell(String.valueOf(i + 1), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "name"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "quantity"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "plus"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "waste"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "wastage2"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "price"), rowColor, marathiFont));
            productTable.addCell(createDataCell(getProductValue(product, "total"), rowColor, marathiFont));
        }

        document.add(productTable);

        // ===== TOTAL SECTION =====
        document.add(new Paragraph("\n"));
        
        Table totalTable = new Table(UnitValue.createPercentArray(new float[]{3, 1}));
        totalTable.setWidth(UnitValue.createPercentValue(40));
        totalTable.setHorizontalAlignment(HorizontalAlignment.RIGHT);
        
        Cell totalLabel = new Cell()
                .setPadding(10)
                .add(new Paragraph("")
                        .setFont(marathiFont)
                        .setFontSize(18)
                        .setFontColor(TEXT_COLOR)
                        .setBold()
                        .setTextAlignment(TextAlignment.CENTER));
        
        Cell totalValue = new Cell()
                .setPadding(10)
                .add(new Paragraph("₹ " + totalAmount + "/-")
                        .setFont(marathiFont)
                        .setFontSize(18)
                        .setFontColor(ColorConstants.WHITE)
                        .setBold()
                        .setTextAlignment(TextAlignment.CENTER));
        
        totalTable.addCell(totalLabel);
        totalTable.addCell(totalValue);
        document.add(totalTable);

        document.close();
        pdf.close();
        writer.close();
    }

    private String getProductValue(Map<String, Object> product, String key) {
        Object value = product.get(key);
        return value != null ? String.valueOf(value) : "-";
    }

    private Cell createDataCell(String text, DeviceRgb backgroundColor, PdfFont font) {
        return new Cell()
                .setBackgroundColor(backgroundColor)
                .setPadding(6)
                .add(new Paragraph(text != null ? text : "-")
                        .setFont(font)
                        .setFontSize(11)
                        .setFontColor(TEXT_COLOR)
                        .setTextAlignment(TextAlignment.CENTER)
                        .setBold());
    }

    @Override
    public ResponseEntity<List<Bill>> getBills() {
        try {
            List<Bill> list;

            if (jwtFilter.isAdmin()) {
                list = billDao.getAllBills();
            } else {
                String username = jwtFilter.getCurrentUsername();
                log.info("Getting bills for user: {}", username);
                list = billDao.getBillByUserName(username);
            }

            log.info("Found {} bills", list.size());
            return new ResponseEntity<>(list, HttpStatus.OK);
        } catch (Exception ex) {
            log.error("Error in getBills", ex);
            ex.printStackTrace();
            return new ResponseEntity<>(new ArrayList<>(), HttpStatus.INTERNAL_SERVER_ERROR);
        }
    }

    @Override
    public ResponseEntity<byte[]> getPdf(Map<String, Object> requestMap) {
        log.info("Inside getPdf {}", requestMap);

        try {
            byte[] byteArray = new byte[0];

            if (!requestMap.containsKey("bill")) {
                log.warn("bill not found in request");
                return new ResponseEntity<>(byteArray, HttpStatus.BAD_REQUEST);
            }

            Integer bill = null;
            Object billObj = requestMap.get("bill");
            if (billObj instanceof Integer) {
                bill = (Integer) billObj;
            } else if (billObj instanceof String) {
                bill = Integer.parseInt((String) billObj);
            } else if (billObj instanceof Number) {
                bill = ((Number) billObj).intValue();
            }

            if (bill == null) {
                log.warn("bill is null after conversion");
                return new ResponseEntity<>(byteArray, HttpStatus.BAD_REQUEST);
            }

            String fileName = "Bill_" + bill;
            String filePath = CafeConstants.STORE_LOCATION + "\\" + fileName + ".pdf";

            log.info("Looking for PDF at: {}", filePath);

            if (!CafeUtils.isFileExist(filePath)) {
                log.warn("PDF not found, attempting to regenerate");
                Optional<Bill> billOptional = billDao.findByBill(bill);
                if (billOptional.isPresent()) {
                    Bill billEntity = billOptional.get();
                    
                    Map<String, Object> regenerateMap = new HashMap<>();
                    regenerateMap.put("bill", bill);
                    regenerateMap.put("name", billEntity.getName());
                    regenerateMap.put("contactNumber", billEntity.getContactNumber());
                    regenerateMap.put("totalAmount", String.valueOf(billEntity.getTotal()));
                    regenerateMap.put("productDetails", billEntity.getProductDetails());
                    
                    generateReport(regenerateMap);
                } else {
                    log.warn("Bill not found for bill: {}", bill);
                    return new ResponseEntity<>(byteArray, HttpStatus.BAD_REQUEST);
                }
            }

            byteArray = getByteArray(filePath);
            log.info("PDF retrieved successfully");
            return new ResponseEntity<>(byteArray, HttpStatus.OK);

        } catch (Exception ex) {
            log.error("Error in getPdf", ex);
            ex.printStackTrace();
        }
        return null;
    }

    @Override
    public ResponseEntity<String> delete(Integer bill) {
        try {
            if (jwtFilter.isAdmin()) {
                Optional<Bill> optional = billDao.findByBill(bill);

                if (optional.isPresent()) {
                    Bill billEntity = optional.get();
                    String fileName = "Bill_" + billEntity.getBill();
                    String filePath = CafeConstants.STORE_LOCATION + "\\" + fileName + ".pdf";
                    File file = new File(filePath);
                    if (file.exists()) {
                        file.delete();
                    }
                    
                    billDao.delete(billEntity);
                    log.info("Bill {} deleted successfully", bill);
                    return CafeUtils.getResponeEntity("Bill deleted successfully", HttpStatus.OK);
                }

                log.warn("Bill not found for deletion: {}", bill);
                return CafeUtils.getResponeEntity("Bill not found", HttpStatus.OK);
            }

            return CafeUtils.getResponeEntity(CafeConstants.UNAUTHORIZED_ACCESS,
                    HttpStatus.UNAUTHORIZED);

        } catch (Exception ex) {
            log.error("Error in delete", ex);
            ex.printStackTrace();
        }

        return CafeUtils.getResponeEntity(CafeConstants.SOMETHING_WENT_WRONG,
                HttpStatus.INTERNAL_SERVER_ERROR);
    }

    @Override
    public ResponseEntity<String> updateStatus(Map<String, String> requestMap, Integer bill) {
        try {
            if (jwtFilter.isAdmin()) {
                Optional<Bill> optional = billDao.findByBill(bill);

                if (!optional.isPresent()) {
                    log.warn("Bill not found for status update: {}", bill);
                    return CafeUtils.getResponeEntity("Bill not found", HttpStatus.OK);
                }

                Bill billEntity = optional.get();
                billEntity.setStatus(requestMap.get("status"));
                billDao.save(billEntity);
                log.info("Bill {} status updated to {}", bill, requestMap.get("status"));

                return CafeUtils.getResponeEntity("Bill status updated successfully",
                        HttpStatus.OK);
            }

            return CafeUtils.getResponeEntity(CafeConstants.UNAUTHORIZED_ACCESS,
                    HttpStatus.UNAUTHORIZED);

        } catch (Exception ex) {
            log.error("Error in updateStatus", ex);
            ex.printStackTrace();
        }

        return CafeUtils.getResponeEntity(CafeConstants.SOMETHING_WENT_WRONG,
                HttpStatus.INTERNAL_SERVER_ERROR);
    }

    @Override
    public ResponseEntity<String> updateProductDetails(Map<String, Object> requestMap) {
        try {
            if (jwtFilter.isAdmin()) {
                Integer bill = (Integer) requestMap.get("bill");
                Optional<Bill> optional = billDao.findByBill(bill);

                if (!optional.isPresent()) {
                    log.warn("Bill not found for product details update: {}", bill);
                    return CafeUtils.getResponeEntity("Bill not found", HttpStatus.OK);
                }

                Bill billEntity = optional.get();
                
                String productDetailsJson = (String) requestMap.get("productDetails");
                JSONArray jsonArray = CafeUtils.getJsonArrayFromString(productDetailsJson);
                
                JSONArray updatedJsonArray = new JSONArray();
                for (int i = 0; i < jsonArray.length(); i++) {
                    Map<String, Object> product = CafeUtils.getMapFromJson(jsonArray.getString(i));
                    calculateWastage2ForProduct(product);
                    updatedJsonArray.put(new org.json.JSONObject(product));
                }
                
                billEntity.setProductDetails(updatedJsonArray.toString());
                
                if (requestMap.containsKey("status")) {
                    billEntity.setStatus((String) requestMap.get("status"));
                }
                
                billDao.save(billEntity);
                log.info("Bill {} product details updated successfully with calculated wastage2 values", bill);
                
                regeneratePdf(billEntity);
                
                return CafeUtils.getResponeEntity("Bill product details updated successfully",
                        HttpStatus.OK);
            }

            return CafeUtils.getResponeEntity(CafeConstants.UNAUTHORIZED_ACCESS,
                    HttpStatus.UNAUTHORIZED);

        } catch (Exception ex) {
            log.error("Error in updateProductDetails", ex);
            ex.printStackTrace();
        }

        return CafeUtils.getResponeEntity(CafeConstants.SOMETHING_WENT_WRONG,
                HttpStatus.INTERNAL_SERVER_ERROR);
    }
    
    private void calculateWastage2ForProduct(Map<String, Object> product) {
        Object wastage2Obj = product.get("wastage2");
        if (wastage2Obj != null) {
            double wastage2 = Double.parseDouble(wastage2Obj.toString());
            Object quantityObj = product.get("quantity");
            if (quantityObj != null) {
                double quantity = Double.parseDouble(quantityObj.toString());
                
                double updatedQuantity = Math.max(0, quantity - wastage2);
                double calculatedWaste = updatedQuantity / 3.33;
                double calculatedDaal = updatedQuantity - calculatedWaste;
                
                product.put("plus", String.format("%.2f", calculatedDaal));
                product.put("waste", String.format("%.2f", calculatedWaste));
                
                log.info("Calculated for product - Wastage2: {}, UpdatedQty: {}, Waste: {}, Daal: {}", 
                        wastage2, updatedQuantity, calculatedWaste, calculatedDaal);
            }
        }
    }
    
    private void regeneratePdf(Bill billEntity) {
        try {
            Integer bill = billEntity.getBill();
            String fileName = "Bill_" + bill;
            
            String filePath = CafeConstants.STORE_LOCATION + "\\" + fileName + ".pdf";
            
            Map<String, Object> requestMap = new HashMap<>();
            requestMap.put("bill", bill);
            requestMap.put("name", billEntity.getName());
            requestMap.put("contactNumber", billEntity.getContactNumber());
            requestMap.put("totalAmount", String.valueOf(billEntity.getTotal()));
            requestMap.put("productDetails", billEntity.getProductDetails());
            
            generateBeautifulPdf(filePath, bill, billEntity.getName(), 
                    billEntity.getContactNumber(), String.valueOf(billEntity.getTotal()), requestMap);
            
            log.info("PDF regenerated successfully for bill: {}", bill);
            
        } catch (Exception ex) {
            log.error("Error regenerating PDF", ex);
            ex.printStackTrace();
        }
    }

    private void insertBill(Map<String, Object> requestMap) {
        try {
            Bill billEntity = new Bill();
            billEntity.setName((String) requestMap.get("name"));
            billEntity.setContactNumber((String) requestMap.get("contactNumber"));
            billEntity.setTotal(Integer.parseInt((String) requestMap.get("totalAmount")));
            billEntity.setProductDetails((String) requestMap.get("productDetails"));
            billEntity.setCreatedBy(jwtFilter.getCurrentUsername());
            billEntity.setStatus("In Progress");
            
            log.info("Inserting bill with createdBy: {}", jwtFilter.getCurrentUsername());
            
            Bill savedBill = billDao.save(billEntity);
            
            requestMap.put("bill", savedBill.getBill());
            log.info("Bill saved with bill: {}", savedBill.getBill());

        } catch (Exception ex) {
            log.error("Error in insertBill", ex);
            ex.printStackTrace();
        }
    }

    private boolean validateResquestMap(Map<String, Object> requestMap) {
        return requestMap.containsKey("name") &&
                requestMap.containsKey("contactNumber") &&
                requestMap.containsKey("productDetails") &&
                requestMap.containsKey("totalAmount");
    }

    private byte[] getByteArray(String filePath) throws Exception {
        InputStream targetStream = new FileInputStream(new File(filePath));
        byte[] byteArray = IOUtils.toByteArray(targetStream);
        targetStream.close();
        return byteArray;
    }
